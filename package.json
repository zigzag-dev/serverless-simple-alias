    "eslint-plugin-unicorn": "80.0.0",
    "globals": "17.14.0",
    "jest": "30.5.2",
    "prettier": "3.10.1"
  },
  "overrides": {
    "glob": "14.0.6",
    "minimatch": "11.0.9"
  },
  "files": [
    "src"
